{
  "name": "ai-visual-dialogue-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "pnpm build && wrangler dev",
    "build": "tsc --noEmit && vite build",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep \"@smoke\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm test:unit && pnpm test:worker",
    "test:unit": "vitest run --exclude \"e2e/**\" --exclude \"**/*.worker.test.ts\"",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "perf:audit": "node scripts/perf-audit.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "prepare": "wrangler types"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "hono": "^4.12.33",
    "i18next": "^26.3.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "xterm": "^5.3.0",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@eslint/js": "9.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "4.1.10",
    "wrangler": "^4.118.0"
  }
}
